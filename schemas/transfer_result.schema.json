{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShadowMap Transfer Result Record",
  "description": "Schema for a ShadowMap transfer test result record.",
  "type": "object",
  "properties": {
    "case": { "type": "string" },
    "node_count": { "type": "integer", "minimum": 0 },
    "factor_count": { "type": "integer", "minimum": 0 },
    "exact_logZ": { "type": "number" },
    "bp_bethe_logZ": { "type": "number" },
    "K_loop_logZ": { "type": "number", "minimum": 0 },
    "mean_var_L1": { "type": "number", "minimum": 0 },
    "max_var_L1": { "type": "number", "minimum": 0 },
    "bp_iters": { "type": "integer", "minimum": 0 },
    "bp_max_delta": { "type": "number", "minimum": 0 },
    "top_factor_residuals": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          { "type": "string" },
          { "type": "number", "minimum": 0 }
        ],
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 1
    },
    "exact_high_probabilities": {
      "type": "object",
      "patternProperties": {
        "^.*$": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "bp_high_probabilities": {
      "type": "object",
      "patternProperties": {
        "^.*$": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "interpretation": { "type": "string" }
  },
  "required": [
    "case",
    "node_count",
    "factor_count",
    "exact_logZ",
    "bp_bethe_logZ",
    "K_loop_logZ",
    "mean_var_L1",
    "max_var_L1",
    "bp_iters",
    "bp_max_delta",
    "top_factor_residuals",
    "exact_high_probabilities",
    "bp_high_probabilities",
    "interpretation"
  ],
  "additionalProperties": false
}
