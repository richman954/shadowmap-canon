{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Formal Proof Result Record",
  "description": "Schema for a formal proof result.",
  "type": "object",
  "properties": {
    "theorem_name": { "type": "string" },
    "formal_statement": { "type": "string" },
    "proof_status": {
      "type": "string",
      "enum": [
        "verified",
        "failed",
        "partial",
        "not_checked"
      ]
    },
    "sorry_count": { "type": "integer", "minimum": 0 },
    "validator": { "type": "string" },
    "build_command": { "type": "string" },
    "shadowmap_interpretation": { "type": "string" }
  },
  "required": [
    "theorem_name",
    "formal_statement",
    "proof_status",
    "sorry_count",
    "validator",
    "build_command",
    "shadowmap_interpretation"
  ],
  "additionalProperties": false
}
